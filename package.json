{
  "name": "developer-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn generate-types && next dev --port 3007",
    "dev:offline": "next dev --port 3007",
    "build": "next build",
    "start": "next start --port 3007",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "prepare": "husky",
    "generate-types": "npx swagger-typescript-api@13.0.23 -p https://pickriders-api-dev.onrender.com/docs/api-json -o ./src/services/apiService --responses --axios --route-types --extract-request-params --extract-request-body --extract-response-body --modular --default-response any --patch --unwrap-response-data",
    "generate-types:local": "npx swagger-typescript-api@13.0.23 -p ../backend-api/swagger.json -o ./src/services/apiService --responses --axios --route-types --extract-request-params --extract-request-body --extract-response-body --modular --default-response any --patch --unwrap-response-data"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.64.2",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^5.1.0",
    "geist": "^1.3.1",
    "lucide-react": "^1.72.0",
    "next": "14.2.1",
    "next-themes": "^0.4.4",
    "react": "^18",
    "react-dom": "^18",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "jest --findRelatedTests --passWithNoTests --coverage=false"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
